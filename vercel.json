{
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/api/backend-api", "destination": "/api/backend-api.js" },
    { "source": "/api/ui-service", "destination": "/api/ui-service.js" }
  ],
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
